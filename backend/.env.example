# ==================== 管理员配置 ====================
# 管理员账号（默认：admin）
ADMIN_USERNAME=admin
# 管理员密码：首次启动必须修改，保留默认值将无法登录管理后台
ADMIN_PASSWORD=change-this-password-now
# 是否启用 /admin 管理后台与 /api/admin 管理接口
ENABLE_ADMIN_BACKEND=true

# ==================== JWT 配置 ====================
# JWT 密钥（自动生成，建议手动设置一个强密钥）
# JWT_SECRET_KEY=your-secret-key-here
# 访问 Token 过期时间（分钟，默认15）
ACCESS_TOKEN_EXPIRE_MINUTES=15
# 刷新 Token 过期时间（天，默认7）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== CORS 配置 ====================
# 允许的前端来源（逗号分隔，* 表示允许所有）
CORS_ORIGINS=*

# ==================== 服务配置 ====================
# 服务端口
PORT=4096
# 主机地址
HOST=0.0.0.0
# 开发模式热重载
RELOAD=false

# ==================== 数据库配置 ====================
# 默认不配置时使用 SQLite：./data/agent.sqlite3
# 也可配置任意 SQLAlchemy 支持的数据库 URL；MySQL/PostgreSQL 需要安装对应驱动。
# AGENT_DATABASE_URL=sqlite:///./data/agent.sqlite3
# AGENT_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/web_ai?charset=utf8mb4
# AGENT_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/web_ai

# ==================== LLM 配置（可选，优先使用 agent-admin.json）====================
# OpenAI 兼容 API 基础 URL
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI API Key
# OPENAI_API_KEY=sk-xxx
# 模型名称
# OPENAI_MODEL_NAME=gpt-4
# OPENAI_MODEL=gpt-4

# 临时 OpenAI 代理服务端口
# OPENAI_PROXY_PORT=8787

# ==================== 知识库配置 ====================
# 知识库目录（默认：webAIDocs）
# WIDGET_KNOWLEDGE_DIR=./webAIDocs
