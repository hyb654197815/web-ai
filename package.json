{
  "name": "portable-ai-agent-widget",
  "version": "1.0.3",
  "description": "便携式前端 AI Agent 入口 - 页面问答、路由跳转与表单操作",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyb654197815/web-ai.git"
  },
  "homepage": "https://github.com/hyb654197815/web-ai#readme",
  "bugs": {
    "url": "https://github.com/hyb654197815/web-ai/issues"
  },
  "keywords": [
    "ai-agent",
    "widget",
    "frontend",
    "webgenerate",
    "knowledge-base",
    "copilot",
    "codex"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/agent-widget.js",
  "module": "./dist/agent-widget.js",
  "exports": {
    ".": {
      "import": "./dist/agent-widget.js",
      "default": "./dist/agent-widget.js"
    },
    "./iife": "./dist/agent-widget.iife.js"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "PRINCIPLES.md",
    "LICENSE",
    "scripts",
    "prompts",
    "templates"
  ],
  "scripts": {
    "readme:github": "node scripts/sync-readme.js github",
    "readme:npm": "node scripts/sync-readme.js npm",
    "prepack": "node scripts/sync-readme.js npm",
    "postpack": "node scripts/sync-readme.js github",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "webGenerate": "node scripts/webGenerate.js"
  },
  "bin": {
    "portable-ai-agent-widget": "./scripts/webGenerate.js",
    "webgenerate": "./scripts/webGenerate.js"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  },
  "dependencies": {
    "page-agent": "^1.6.2",
    "zod": "^4.0.0"
  }
}
